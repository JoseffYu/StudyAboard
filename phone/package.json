{
  "name": "studyaboard-phone",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo install --check && expo config --type public",
    "test": "node tests/config.test.cjs && npm run typecheck",
    "build:preview:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:production": "npx eas-cli@latest build --platform all --profile production"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-audio": "~58.0.0",
    "expo-crypto": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-linear-gradient": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.0"
  }
}
